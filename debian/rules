#!/usr/bin/make -f

export CARGO = /usr/share/cargo/bin/cargo
export CARGO_VENDOR_DIR = rust-vendor
export CARGO_HOME = $(CURDIR)/debian/cargo_home

include /usr/share/dpkg/pkg-info.mk
include /usr/share/rustc/architecture.mk
export DEB_HOST_RUST_TYPE DEB_HOST_GNU_TYPE

VENDOR_TARBALL = ${DEB_SOURCE}_$(DEB_VERSION_UPSTREAM).orig-$(CARGO_VENDOR_DIR).tar.xz

vendor-tarball-sanity-check:
	if [ -e ../$(VENDOR_TARBALL) ]; \
		then echo "../$(VENDOR_TARBALL) already exists, bailing!"; \
		exit 1; \
	fi

vendor-deps:
	rm -rf $(CARGO_VENDOR_DIR)
	cargo vendor --manifest-path Cargo.toml $(CARGO_VENDOR_DIR)

	for crate in $(CARGO_VENDOR_DIR)/*; do \
		sed -i 's/^{"files":.*"package":\("\{0,1\}[a-z0-9]\+"\{0,1\}\)}$$/{"files":{},"package":\1}/' $$crate/.cargo-checksum.json; \
	done

	# Cleanup temp files
	rm -rf $(CARGO_HOME)

vendor-tarball: vendor-tarball-sanity-check
	tar --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner --pax-option=exthdr.name=%d/PaxHeaders/%f,delete=atime,delete=ctime -caf ../$(VENDOR_TARBALL) $(CARGO_VENDOR_DIR)

%:
	dh $@ --buildsystem=cargo

override_dh_dwz:
	true

override_dh_auto_test:
	true

override_dh_auto_configure:
	# Prepare vendored rust dependencies
	DEB_CARGO_CRATE=${DEB_SOURCE}_$(shell dpkg-parsechangelog --show-field Version) \
	$(CARGO) prepare-debian $(CARGO_VENDOR_DIR)
	/usr/share/cargo/bin/dh-cargo-vendored-sources
	dh_auto_configure

override_dh_auto_install:
	DEB_CARGO_CRATE=${DEB_SOURCE}_$(shell dpkg-parsechangelog --show-field Version) \
	DESTDIR=debian/niri $(CARGO) install --locked

override_dh_clean:
	dh_clean
	rm -rf wiki/img
	rm -rf $(CARGO_HOME)
