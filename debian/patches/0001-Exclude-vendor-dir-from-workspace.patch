From: Tobias Heider <me@tobhe.de>
Date: Mon, 7 Jul 2025 19:08:58 +0200
Subject: Exclude vendor dir from workspace

---
 .cargo/config.toml | 7 +++++++
 Cargo.toml         | 1 +
 2 files changed, 8 insertions(+)
 create mode 100644 .cargo/config.toml

diff --git a/.cargo/config.toml b/.cargo/config.toml
new file mode 100644
index 0000000..ef6cf75
--- /dev/null
+++ b/.cargo/config.toml
@@ -0,0 +1,7 @@
+[source."git+https://github.com/Smithay/smithay.git"]
+git = "https://github.com/Smithay/smithay.git"
+replace-with = "dh-cargo-registry"
+
+[source."git+https://gitlab.freedesktop.org/pipewire/pipewire-rs.git"]
+git = "https://gitlab.freedesktop.org/pipewire/pipewire-rs.git"
+replace-with = "dh-cargo-registry"
diff --git a/Cargo.toml b/Cargo.toml
index ed1d8b6..4882035 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -4,6 +4,7 @@ members = [
     "niri-ipc",
     "niri-visual-tests",
 ]
+exclude = ["rust-vendor"]
 
 [workspace.package]
 version = "25.5.1"
